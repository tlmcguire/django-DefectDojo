digraph trust {
graph [bgcolor="white", pad="0.18", ranksep="0.33", nodesep="0.22", fontname="Helvetica", fontcolor="#143043"]; node [shape=box, style="rounded,filled", fillcolor="#EEF4F8", color="#7596A8", fontname="Helvetica", fontcolor="#143043", fontsize=12, margin="0.14,0.09"]; edge [color="#5C7687", fontname="Helvetica", fontcolor="#29465A", fontsize=9, arrowsize=0.72];
subgraph cluster_external { label="External"; browser [label="Users and scanners"]; ext [label="External integrations"]; }
subgraph cluster_app { label="Application tier"; proxy [label="Nginx"]; django [label="Django\nAuthenticate, authorize, validate"]; worker [label="Celery worker"]; }
subgraph cluster_internal { label="Internal state"; db [label="PostgreSQL and audit history"]; files [label="Attachment storage"]; queue [label="Valkey broker and cache"]; }
browser -> proxy [label="HTTP requests or scan files"]; proxy -> django; ext -> django [label="integration inputs"];
django -> db [label="authorized ORM writes"]; django -> files [label="uploads and reads"]; django -> queue [label="task messages"]; queue -> worker; worker -> db;
}
