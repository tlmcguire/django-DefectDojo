digraph state {
graph [bgcolor="white", pad="0.18", ranksep="0.33", nodesep="0.22", fontname="Helvetica", fontcolor="#143043"]; node [shape=box, style="rounded,filled", fillcolor="#EEF4F8", color="#7596A8", fontname="Helvetica", fontcolor="#143043", fontsize=12, margin="0.14,0.09"]; edge [color="#5C7687", fontname="Helvetica", fontcolor="#29465A", fontsize=9, arrowsize=0.72];
start [label="New Engagement"]; un [label="Unnumbered"]; yes [label="Numbered",fillcolor="#D6F3ED"]; end [label="Deleted"];
start -> un [label="No format"]; start -> yes [label="Configured"]; un -> yes [label="Move to configured Product"]; yes -> un [label="Move to unnumbered Product"]; yes -> yes [label="Move to configured Product / reissue"]; {un yes} -> end [label="Delete"];
}
